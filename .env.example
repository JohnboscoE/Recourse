# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must NEVER be committed or shared.

# Your KeeperHub API key (starts with kh_)
KH_API_KEY=kh_your_key_here

# Deployed RecourseEscrow contract on Base (public info)
ESCROW_ADDRESS=0xE21A7446a89b3A8C9A455dC5e1c2A61D21E25982

# Base RPC endpoint (public default shown; swap for a private one if rate-limited)
BASE_RPC_URL=https://mainnet.base.org

# Optional overrides
# KH_BASE_URL=https://app.keeperhub.com
# KH_WORKFLOW_ID=
# RESOLVER_POLL_MS=15000   # >0 enables the backend background resolve loop
# PORT=3001
