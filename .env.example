# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must NEVER be committed or shared.

# Your KeeperHub API key (starts with kh_)
KH_API_KEY=kh_your_key_here

# Deployed RecourseEscrow contract on Base (public info)
ESCROW_ADDRESS=0xE21A7446a89b3A8C9A455dC5e1c2A61D21E25982

# Base RPC endpoint (public default shown; swap for a private one if rate-limited)
BASE_RPC_URL=https://mainnet.base.org

# Optional overrides
# KH_BASE_URL=https://app.keeperhub.com
# RESOLVER_POLL_MS=30000   # 0 disables automatic settlement (default: 30000)
# PORT=3001                # hosts like Railway set this for you

# --- Deployment ---
# Comma-separated list of browser origins allowed to call this API. Unset
# reflects whatever origin asks, which is fine locally but should be pinned
# once the frontend is deployed to its own domain.
# CORS_ORIGINS=https://recourse.vercel.app,http://localhost:5173

# --- Execution transport ---
# "mcp" (default) routes agent execution through the KeeperHub MCP server;
# "rest" uses the /api/execute/* endpoints. MCP falls back to REST automatically
# on transport failures, so this is only for forcing one path during debugging.
# KH_TRANSPORT=mcp
# KH_MCP_PATH=/mcp

# --- Chain read tuning ---
# Verification reads are cached this long (ms). A Base block is ~2s, so a few
# seconds costs no correctness and keeps a polling UI inside RPC rate limits.
# CHAIN_CACHE_MS=5000
# BALANCE_CACHE_MS=15000

# --- x402 (agent-as-payer) ---
# The agentic wallet lives at ~/.keeperhub/wallet.json, provisioned with:
#   npx -p @keeperhub/wallet keeperhub-wallet add
# It is separate from the KeeperHub execution wallet and needs its own USDC.
# No key material belongs in this file.
